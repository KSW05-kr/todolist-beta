// MARK: - 5. 스와이프 달력 뷰 (2년 범위 지원)
struct CalendarView: View {
    let months: [Date]
    @Binding var selectedDate: Date
    let todoList: [TodoItem]
    
    var body: some View {
        TabView {
            ForEach(months, id: \.self) { monthDate in
                MonthGridView(monthDate: monthDate, selectedDate: $selectedDate, todoList: todoList)
            }
        }
        .tabViewStyle(PageTabViewStyle(indexDisplayMode: .never))
    }
}

struct MonthGridView: View {
    let monthDate: Date
    @Binding var selectedDate: Date
    let todoList: [TodoItem]
    
    let daysOfWeek = ["일", "월", "화", "수", "목", "금", "토"]
    
    var body: some View {
        VStack(spacing: 10) {
            // 월 타이틀
            Text(monthHeaderTitle(monthDate))
                .font(.title3)
                .fontWeight(.bold)
                .foregroundColor(.white)
            
            // 요일 헤더
            HStack {
                ForEach(daysOfWeek, id: \.self) { day in
                    Text(day)
                        .font(.caption)
                        .fontWeight(.semibold)
                        .foregroundColor(.gray)
                        .frame(maxWidth: .infinity)
                }
            }
            
            // 날짜 그리드
            let days = generateDaysInMonth(monthDate)
            LazyVGrid(columns: Array(repeating: GridItem(.flexible()), count: 7), spacing: 12) {
                ForEach(days, id: \.self) { date in
                    if let date = date {
                        DayCell(
                            date: date,
                            isSelected: Calendar.current.isDate(date, inSameDayAs: selectedDate),
                            status: getTaskStatus(for: date),
                            onTap: { selectedDate = date }
                        )
                    } else {
                        Text("")
                            .frame(maxWidth: .infinity)
                    }
                }
            }
        }
        .padding()
        .background(Color(white: 0.08))
        .cornerRadius(16)
        .padding(.horizontal)
    }
    
    func monthHeaderTitle(_ date: Date) -> String {
        let formatter = DateFormatter()
        formatter.locale = Locale(identifier: "ko_KR")
        formatter.dateFormat = "yyyy년 M월"
        return formatter.string(from: date)
    }
    
    enum TaskStatus {
        case isToday
        case completed
        case uncompleted
        case none
    }
    
    func getTaskStatus(for date: Date) -> TaskStatus {
        let calendar = Calendar.current
        if calendar.isDateInToday(date) {
            return .isToday
        }
        
        let daysTodos = todoList.filter { calendar.isDate($0.date, inSameDayAs: date) }
        if daysTodos.isEmpty { return .none }
        
        let allCompleted = daysTodos.allSatisfy { $0.isCompleted }
        if allCompleted {
            return .completed
        } else if date < calendar.startOfDay(for: Date()) {
            return .uncompleted
        }
        return .none
    }
    
    func generateDaysInMonth(_ date: Date) -> [Date?] {
        let calendar = Calendar.current
        guard let monthInterval = calendar.dateInterval(of: .month, for: date),
              let firstWeekday = calendar.dateComponents([.weekday], from: monthInterval.start).weekday else { return [] }
        
        var days: [Date?] = Array(repeating: nil, count: firstWeekday - 1)
        
        let numberOfDays = calendar.range(of: .day, in: .month, for: date)!.count
        for day in 1...numberOfDays {
            if let dayDate = calendar.date(byAdding: .day, value: day - 1, to: monthInterval.start) {
                days.append(dayDate)
            }
        }
        return days
    }
}

// MARK: - 6. 날짜 셀 UI (파란색 원, 초록색 동그라미, 빨간색 세모)
struct DayCell: View {
    let date: Date
    let isSelected: Bool
    let status: MonthGridView.TaskStatus
    let onTap: () -> Void
    
    var isToday: Bool {
        Calendar.current.isDateInToday(date)
    }
    
    var dayText: String {
        let formatter = DateFormatter()
        formatter.dateFormat = "d"
        return formatter.string(from: date)
    }
    
    var body: some View {
        VStack(spacing: 4) {
            ZStack {
                // 당일 날짜인 경우: 파란색 채워진 원
                if isToday {
                    Circle()
                        .fill(Color.blue)
                        .frame(width: 32, height: 32)
                } else if isSelected {
                    Circle()
                        .stroke(Color.white, lineWidth: 2)
                        .frame(width: 32, height: 32)
                }
                
                Text(dayText)
                    .font(.system(size: 14, weight: isToday ? .bold : .regular))
                    .foregroundColor(isToday ? .white : .white)
            }
            
            // 날짜 밑 상태 표시 마크
            Group {
                switch status {
                case .completed:
                    // 완료한 날: 작은 초록색 동그라미
                    Circle()
                        .fill(Color.green)
                        .frame(width: 6, height: 6)
                case .uncompleted:
                    // 안 한 날짜: 빨간색 세모
                    RedTriangle()
                        .fill(Color.red)
                        .frame(width: 8, height: 7)
                default:
                    Spacer()
                        .frame(height: 6)
                }
            }
        }
        .frame(height: 44)
        .onTapGesture {
            onTap()
        }
    }
}
