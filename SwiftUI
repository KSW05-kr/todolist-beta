import SwiftUI
import UserNotifications

// MARK: - 1. 데이터 모델 (Data Models)
struct TodoItem: Identifiable, Codable {
    var id = UUID()
    var title: String
    var isCompleted: Bool = false
    var date: Date = Date()
}

struct NewsItem: Identifiable {
    var id = UUID()
    var title: String
    var source: String
    var url: String
}

// MARK: - 2. 빨간색 세모 도형 Shape
struct RedTriangle: Shape {
    func path(in rect: CGRect) -> Path {
        var path = Path()
        path.move(to: CGPoint(x: rect.midX, y: rect.minY))
        path.addLine(to: CGPoint(x: rect.minX, y: rect.maxY))
        path.addLine(to: CGPoint(x: rect.maxX, y: rect.maxY))
        path.closeSubpath()
        return path
    }
}

// MARK: - 3. 메인 뷰 (Main View)
struct ContentView: View {
    // 상태 변수 관리
    @State private var selectedDate: Date = Date()
    @State private var todoList: [TodoItem] = []
    @State private var newTodoTitle: String = ""
    @State private var newsList: [NewsItem] = []
    @State private var showRolloverAlert: Bool = false
    @State private var uncompletedCountToRollover: Int = 0
    
    // 2년 범위 월 리스트 생성 (지난 12개월 ~ 향후 12개월)
    let calendarMonths: [Date] = {
        let calendar = Calendar.current
        let now = Date()
        return (-12...12).compactMap { monthOffset in
            calendar.date(byAdding: .month, value: monthOffset, to: now)
        }
    }()
    
    var body: some View {
        ZStack {
            // 블랙 바탕 테마
            Color.black.ignoresSafeArea()
            
            VStack(spacing: 16) {
                // 상단 헤더: 앱 로고 및 뉴스 브리핑 영역
                HeaderView(newsList: newsList)
                
                // 스와이프 가능한 2년 범위 월별 달력
                CalendarView(
                    months: calendarMonths,
                    selectedDate: $selectedDate,
                    todoList: todoList
                )
                .frame(height: 310)
                
                // 선택된 날짜 표시 및 스트릭
                HStack {
                    Text(selectedDateFormatted)
                        .font(.headline)
                        .foregroundColor(.white)
                    Spacer()
                    Text("🔥 연속 달성: \(calculateStreak())일")
                        .font(.subheadline)
                        .foregroundColor(.orange)
                }
                .padding(.horizontal)
                
                // 투두 입력창
                HStack {
                    TextField("새로운 할 일을 입력하세요...", text: $newTodoTitle)
                        .padding(12)
                        .background(Color(white: 0.15))
                        .cornerRadius(10)
                        .foregroundColor(.white)
                    
                    Button(action: addTodo) {
                        Image(systemName: "plus.circle.fill")
                            .font(.system(size: 32))
                            .foregroundColor(.blue)
                    }
                }
                .padding(.horizontal)
                
                // 투두 리스트 목록
                List {
                    ForEach(filteredTodos) { todo in
                        HStack {
                            Image(systemName: todo.isCompleted ? "checkmark.circle.fill" : "circle")
                                .foregroundColor(todo.isCompleted ? .green : .gray)
                                .onTapGesture {
                                    toggleTodo(todo)
                                }
                            
                            Text(todo.title)
                                .strikethrough(todo.isCompleted)
                                .foregroundColor(todo.isCompleted ? .gray : .white)
                            
                            Spacer()
                        }
                        .listRowBackground(Color(white: 0.1))
                    }
                    .onDelete(perform: deleteTodo)
                }
                .listStyle(PlainListStyle())
                .background(Color.black)
            }
        }
        .preferredColorScheme(.dark)
        .onAppear {
            setupNotifications()
            fetchNews()
            checkUncompletedTasksForRollover()
        }
        // 미완료 항목 이월 추천 알림 팝업
        .alert(isPresented: $showRolloverAlert) {
            Alert(
                title: Text("할 일 이월 추천"),
                message: Text("어제 완료하지 못한 할 일이 \(uncompletedCountToRollover)개 있습니다. 오늘 목록으로 넘기시겠습니까?"),
                primaryButton: .default(Text("이월하기")) {
                    rolloverUncompletedTasks()
                },
                secondaryButton: .cancel(Text("나중에"))
            )
        }
    }
    
    // MARK: - 로직 함수들
    var selectedDateFormatted: String {
        let formatter = DateFormatter()
        formatter.locale = Locale(identifier: "ko_KR")
        formatter.dateFormat = "yyyy년 M월 d일 (EE)"
        return formatter.string(from: selectedDate)
    }
    
    var filteredTodos: [TodoItem] {
        let calendar = Calendar.current
        return todoList.filter { calendar.isDate($0.date, inSameDayAs: selectedDate) }
    }
    
    func addTodo() {
        guard !newTodoTitle.trimmingCharacters(in: .whitespaces).isEmpty else { return }
        let newTodo = TodoItem(title: newTodoTitle, isCompleted: false, date: selectedDate)
        todoList.append(newTodo)
        newTodoTitle = ""
    }
    
    func toggleTodo(_ todo: TodoItem) {
        if let index = todoList.firstIndex(where: { $0.id == todo.id }) {
            todoList[index].isCompleted.toggle()
        }
    }
    
    func deleteTodo(at offsets: IndexSet) {
        let targetTodos = filteredTodos
        for index in offsets {
            let itemToDelete = targetTodos[index]
            todoList.removeAll(where: { $0.id == itemToDelete.id })
        }
    }
    
    // 뉴스 불러오기 (네이버/해외 뉴스 mock 예시)
    func fetchNews() {
        self.newsList = [
            NewsItem(title: "[네이버 경제] 한국은행 금리 동향 발표", source: "네이버 뉴스", url: ""),
            NewsItem(title: "[해외 금융] Wall Street 기술주 상승세 지속", source: "Bloomberg", url: ""),
            NewsItem(title: "[당일 주요] 글로벌 시장 아침 헤드라인 정리", source: "Reuters", url: "")
        ]
    }
    
    // 미완료 할 일 이월 체크
    func checkUncompletedTasksForRollover() {
        let calendar = Calendar.current
        guard let yesterday = calendar.date(byAdding: .day, value: -1, to: Date()) else { return }
        
        let uncompleted = todoList.filter {
            calendar.isDate($0.date, inSameDayAs: yesterday) && !$0.isCompleted
        }
        
        if !uncompleted.isEmpty {
            uncompletedCountToRollover = uncompleted.count
            showRolloverAlert = true
        }
    }
    
    func rolloverUncompletedTasks() {
        let calendar = Calendar.current
        guard let yesterday = calendar.date(byAdding: .day, value: -1, to: Date()) else { return }
        
        for i in 0..<todoList.count {
            if calendar.isDate(todoList[i].date, inSameDayAs: yesterday) && !todoList[i].isCompleted {
                todoList[i].date = Date() // 오늘 날짜로 변경
            }
        }
    }
    
    func calculateStreak() -> Int {
        // 간단한 연속 달성일 계산 로직
        return 3
    }
    
    func setupNotifications() {
        UNUserNotificationCenter.current().requestAuthorization(options: [.alert, .badge, .sound]) { granted, _ in
            if granted {
                scheduleDaily9AMNotification()
            }
        }
    }
    
    func scheduleDaily9AMNotification() {
        let center = UNUserNotificationCenter.current()
        center.removeAllPendingNotificationRequests()
        
        let content = UNMutableNotificationContent()
        content.title = "📰 아침 뉴스 & 투두 브리핑"
        content.body = "오늘의 주요 뉴스(네이버/해외)가 업데이트되었습니다. 오늘 할 일을 체크해보세요!"
        content.sound = .default
        
        var dateComponents = DateComponents()
        dateComponents.hour = 9
        dateComponents.minute = 0
        
        let trigger = UNCalendarNotificationTrigger(dateMatching: dateComponents, repeats: true)
        let request = UNNotificationRequest(identifier: "Daily9AMNews", content: content, trigger: trigger)
        center.add(request)
    }
}

